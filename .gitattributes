int main() {
    int a = 10;
    int* p = &a; // p 儲存了 a 的位址

    std::cout << "a 的值: " << a << std::endl;        // 10
    std::cout << "a 的位址: " << &a << std::endl;     // 例如 0x7ffe...
    std::cout << "指標 p 的內容: " << p << std::endl; // 與 &a 相同
    std::cout << "解引用 p (*p): " << *p << std::endl; // 10 (回到 a 的值)
    
    return 0;
}